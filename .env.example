# claude-starter 環境変数の見本
#
# - ここには「変数名と意味」だけを書く。値は書かない
# - 実値は .env（Git 管理外）に置く。値の所在は 環境情報.md §5 に書く
# - 変数を足す・消すときは 環境情報.md §5 の表と対で保つ（update-env-info スキル）
#
# 使い方: cp .env.example .env → 環境情報.md を見て値を埋める

# --- アプリ ---
# 動作モード（development / production 等）
APP_ENV=

# --- データベース ---
# 接続文字列。パスワードを含むため .env にだけ書く
DATABASE_URL=

# --- 外部サービス ---
# API キー。発行元と用途は 環境情報.md §5
# EXTERNAL_API_KEY=
